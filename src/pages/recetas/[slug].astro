---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const recetas = await getCollection('recetas');
  const total = recetas.length;

  return recetas.map((receta, index) => {
    const prev = index > 0
      ? { slug: recetas[index - 1].id, titulo: recetas[index - 1].data.titulo }
      : null;

    const next = index < total - 1
      ? { slug: recetas[index + 1].id, titulo: recetas[index + 1].data.titulo }
      : null;

    const rels = recetas
      .filter(r => r.data.categoria === receta.data.categoria && r.id !== receta.id)
      .slice(0, 3)
      .map(r => ({ slug: r.id, titulo: r.data.titulo }));

    return {
      params: { slug: receta.id },
      props: {
        receta: receta.data,
        slug: receta.id,
        prev,
        next,
        rels,
      },
    };
  });
}

const { receta, slug, prev, next, rels } = Astro.props;

const recetaJSON = JSON.stringify(receta).replace(/<\/script/g, '<\\/script');

// Centralización de dominio: todo se construye a partir de Astro.site.
const SITE = Astro.site ?? new URL('https://recetariochileno.netlify.app');

// FASE 3 (auditoría): URL limpia → /recetas/{slug}/
const url = new URL(`/recetas/${slug}/`, SITE).toString();
const img = receta.imagen && receta.imagen.trim() !== ''
  ? new URL(`/${receta.imagen}`, SITE).toString()
  : new URL('/img/og-default.jpg', SITE).toString();

// FASE 2 (Mejora 2): si la receta tiene imagen propia, sabemos sus dimensiones
// porque el <img> de abajo las declara (1200×675). Si cae en la imagen por
// defecto, NO inventamos width/height.
const tieneImagenPropia = !!(receta.imagen && receta.imagen.trim() !== '');

// Guías recomendadas (URLs limpias)
const GUIAS = {
  'pastel-de-choclo': { titulo: 'Cómo elegir un buen choclo', url: '/guias/como-elegir-un-choclo/' },
  'humitas': { titulo: 'Cómo elegir un buen choclo', url: '/guias/como-elegir-un-choclo/' },
  'porotos-granados': { titulo: 'Cómo elegir un buen choclo', url: '/guias/como-elegir-un-choclo/' },
  'pan-amasado': { titulo: 'Cómo hacer que el pan suba', url: '/guias/como-hacer-que-el-pan-suba/' },
  'hallulla': { titulo: 'Cómo hacer que el pan suba', url: '/guias/como-hacer-que-el-pan-suba/' },
  'marraqueta': { titulo: 'Cómo hacer que el pan suba', url: '/guias/como-hacer-que-el-pan-suba/' },
  'paila-marina': { titulo: 'Cómo saber si los mariscos están frescos', url: '/guias/como-saber-si-los-mariscos-estan-frescos/' },
  'machas-a-la-parmesana': { titulo: 'Cómo saber si los mariscos están frescos', url: '/guias/como-saber-si-los-mariscos-estan-frescos/' },
  'locos-con-mayonesa': { titulo: 'Cómo saber si los mariscos están frescos', url: '/guias/como-saber-si-los-mariscos-estan-frescos/' },
  'carne-mechada': { titulo: 'Cómo evitar que la carne quede seca', url: '/guias/como-evitar-que-la-carne-quede-seca/' },
  'bistec-a-lo-pobre': { titulo: 'Cómo evitar que la carne quede seca', url: '/guias/como-evitar-que-la-carne-quede-seca/' },
  'pollo-asado': { titulo: 'Cómo encender el carbón', url: '/guias/como-encender-carbon-parrilla/' },
  'chorrillana': { titulo: 'Cortes de carne para Parrilla', url: '/guias/cortes-de-carne-parrilla/' }
};
const guiaAsociada = GUIAS[slug];

const ingPrincipales = receta.ingredientes.slice(0, 3).map(x => x.split(':').pop().trim()).join(', ');
const resumenTexto = `Para preparar ${receta.titulo} necesitas ${ingPrincipales}. Es una receta de dificultad ${receta.dificultad || 'fácil'} que toma ${receta.tiempo || 'un tiempo'} y rinde ${receta.porciones || '4 porciones'}.`;

// FASE 2 (Mejora 2): descripción única por receta para <meta name="description">
// y og:description. Se compone con datos ya existentes (título, tiempo,
// dificultad) para evitar el texto genérico "Receta chilena de X. Ingredientes
// y preparación paso a paso." y se trunca a 160 caracteres respetando palabras.
const DESCRIPCION_MAX = 160;
function truncarDescripcion(texto, max = DESCRIPCION_MAX) {
  if (!texto) return '';
  const limpio = String(texto).replace(/\s+/g, ' ').trim();
  if (limpio.length <= max) return limpio;
  const corte = limpio.slice(0, max - 1);
  const ultimoEspacio = corte.lastIndexOf(' ');
  return (ultimoEspacio > 0 ? corte.slice(0, ultimoEspacio) : corte) + '…';
}
const descripcionSEO = truncarDescripcion(
  `${receta.titulo}: receta chilena` +
  `${receta.tiempo ? ' lista en ' + receta.tiempo : ''}` +
  `${receta.dificultad ? ', dificultad ' + String(receta.dificultad).toLowerCase() : ''}` +
  `. Ingredientes, preparación paso a paso y consejos.`
);

// FASE 1 (auditoría): convierte duraciones humanas a ISO 8601
function aISODuracion(t) {
  if (!t) return undefined;
  const s = String(t).toLowerCase();
  const mH = s.match(/(\d+)\s*(?:h|hrs?|horas?)\b/);
  const mM = s.match(/(\d+)\s*(?:min|mins?|minutos?)\b/);
  let horas = mH ? parseInt(mH[1], 10) : 0;
  let minutos = mM ? parseInt(mM[1], 10) : 0;
  if (horas === 0 && minutos === 0) {
    const soloNum = s.match(/^\s*(\d+)\s*$/);
    if (soloNum) minutos = parseInt(soloNum[1], 10);
  }
  if (horas === 0 && minutos === 0) return undefined;
  return 'PT' + (horas > 0 ? horas + 'H' : '') + (minutos > 0 ? minutos + 'M' : '');
}
const totalTimeISO = aISODuracion(receta.tiempo);

const schemaObj = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": receta.titulo,
  "image": [img],
  "author": { "@type": "Organization", "name": "Recetario Chileno" },
  "description": `Receta tradicional chilena de ${receta.titulo}.`,
  "recipeCuisine": "Chilena",
  "recipeCategory": receta.categoria,
  "keywords": (receta.tags || []).join(', '),
  "recipeYield": receta.porciones,
  "recipeIngredient": receta.ingredientes,
  "recipeInstructions": receta.pasos.map((p, i) => ({ "@type": "HowToStep", "position": i + 1, "text": p }))
};

// FASE 10: si hay tiempo_v2, usar prepTime / cookTime / restTime.
// Si no, caer al totalTime derivado de receta.tiempo.
if (receta.tiempo_v2) {
  const tv = receta.tiempo_v2;
  if (tv.preparacion) schemaObj.prepTime = 'PT' + tv.preparacion + 'M';
  if (tv.coccion) schemaObj.cookTime = 'PT' + tv.coccion + 'M';
  if (tv.reposo) schemaObj.restTime = 'PT' + tv.reposo + 'M';
  const total = (tv.preparacion || 0) + (tv.coccion || 0) + (tv.reposo || 0);
  if (total > 0) schemaObj.totalTime = 'PT' + total + 'M';
} else if (totalTimeISO) {
  schemaObj.totalTime = totalTimeISO;
}

const schema = JSON.stringify(schemaObj);

// Centralización de dominio: breadcrumb dinámico vía SITE.
const bread = JSON.stringify({
  "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Inicio", "item": new URL('/', SITE).toString()},
    {"@type": "ListItem", "position": 2, "name": "Recetas", "item": new URL('/recetario/', SITE).toString()},
    {"@type": "ListItem", "position": 3, "name": receta.titulo, "item": url}
  ]
});

const msjWA = `Mira esta receta de ${receta.titulo} en Recetario Chileno: ${url}`;
const linkWA = `https://api.whatsapp.com/send?text=${encodeURIComponent(msjWA)}`;
const msjPin = `Receta chilena: ${receta.titulo} | Recetario Chileno`;
const linkPin = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&media=${encodeURIComponent(img)}&description=${encodeURIComponent(msjPin)}`;

const ICON_CLOCK = '<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
const ICON_PORCIONES = '<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2v6a3 3 0 0 0 6 0V2"/><path d="M8 11v11"/><path d="M20 2c-2 3-3 6-3 9h3v11"/></svg>';
const ICON_DIFICULTAD = '<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>';
const ICON_TECNICA = '<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>';
const ICON_STAR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
const ICON_LIBRO = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>';
---

<Layout
  title={receta.titulo}
  description={descripcionSEO}
  activePage="recetas"
  image={img}
  imageWidth={tieneImagenPropia ? 1200 : undefined}
  imageHeight={tieneImagenPropia ? 675 : undefined}
  imageAlt={receta.titulo}
  ogType="article"
>

  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={schema}></script>
    <script type="application/ld+json" set:html={bread}></script>
  </Fragment>

  <!-- FASE 1 — HERO "FICHA GASTRONÓMICA EDITORIAL" -->
  <header class="hero-receta">
    <div class="hero-receta-inner">
      <nav class="breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a> <span>›</span> <a href="/recetario/">Recetas</a> <span>›</span> <span class="breadcrumb-current">{receta.titulo}</span>
      </nav>
      <h1>{receta.titulo}</h1>

      <div class="hero-media-wrap">
        <div class="hero-media" style={tieneImagenPropia ? `--bg-img: url('/${receta.imagen}')` : ''}>
          {tieneImagenPropia ? (
            <img
              class="hero-media-img"
              src={'/' + receta.imagen}
              alt={receta.titulo}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="675"
            />
          ) : (
            <div
              class="hero-placeholder"
              role="img"
              aria-label={`Portada de la receta: ${receta.titulo}`}
            >
              <span class="hero-placeholder-titulo">{receta.titulo}</span>
            </div>
          )}
          <button
            type="button"
            class="btn-favorito hero-fav-flotante"
            data-slug={slug}
            aria-label="Guardar en favoritos"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </button>
        </div>
      </div>

      <div class="meta-grid">
        {receta.tiempo && (
          <div class="meta-item">
            <span class="meta-item-icon" set:html={ICON_CLOCK} aria-hidden="true"></span>
            <span class="meta-item-label">Tiempo</span>
            <span class="meta-item-valor">{receta.tiempo}</span>
          </div>
        )}
        {receta.porciones && (
          <div class="meta-item">
            <span class="meta-item-icon" set:html={ICON_PORCIONES} aria-hidden="true"></span>
            <span class="meta-item-label">Porciones</span>
            <span class="meta-item-valor">{receta.porciones}</span>
          </div>
        )}
        {receta.dificultad && (
          <div class="meta-item">
            <span class="meta-item-icon" set:html={ICON_DIFICULTAD} aria-hidden="true"></span>
            <span class="meta-item-label">Dificultad</span>
            <span class="meta-item-valor">{receta.dificultad}</span>
          </div>
        )}
      </div>

      {receta.tecnica && (
        <div class="meta-tecnica">
          <span class="meta-tecnica-icon" set:html={ICON_TECNICA} aria-hidden="true"></span>
          <span>{receta.tecnica}</span>
        </div>
      )}
    </div>
  </header>

  <main class="receta-page">
    <div class="resumen-aeo">
      <strong>Respuesta rápida:</strong> {resumenTexto}
    </div>

    <div class="receta-barra">
      <div class="receta-acciones-top" style="margin-bottom:0;">

        {/* FASE B — Botón único "Imprimir" con dropdown nativo (<details>).
            Dos opciones: toda la receta / solo ingredientes marcados.
            El contador "X/Y" aparece solo si hay al menos 1 marcado. */}
        <details class="btn-imprimir-menu">
          <summary class="btn-imprimir">
            🖨️ Imprimir
            <svg class="chevron-imprimir" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="imprimir-opciones">
            <button type="button" class="imprimir-opcion" data-imprimir="todo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 9V2h12v7"/>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                <path d="M6 14h12v8H6z"/>
              </svg>
              <span>Toda la receta</span>
            </button>
            <button type="button" class="imprimir-opcion" data-imprimir="marcados">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>Solo ingredientes marcados</span>
              <span class="contador-marcados" hidden></span>
            </button>
          </div>
        </details>

        <button type="button" class="btn-modo-cocina">👨‍🍳 Modo cocina</button>
        <button
          type="button"
          class="btn-offline"
          data-url={`/recetas/${slug}/`}
          data-image={tieneImagenPropia ? '/' + receta.imagen : ''}
        >
          📥 Guardar para cocinar sin conexión
        </button>
      </div>

      <div class="rating-container" data-slug={slug}>
        <div class="rating-stars" role="group" aria-label="Calificación de la receta">
          {Array.from({ length: 5 }).map((_, i) => (
            <button
              type="button"
              class="rating-star"
              data-value={i + 1}
              aria-label={`Calificar con ${i + 1} ${i === 0 ? 'estrella' : 'estrellas'}`}
              aria-pressed="false"
              set:html={ICON_STAR}
            ></button>
          ))}
        </div>
        <span class="rating-text">Califica esta receta</span>
      </div>
    </div>

    <article class="receta">
      {receta.advertencia && (
        <div class="advertencia-box" role="alert">
          <div class="advertencia-icon">⚠️</div>
          <div class="advertencia-texto">
            <strong>Advertencia importante:</strong> {receta.advertencia}
          </div>
        </div>
      )}

      <!-- FASE 5C: navegación segmentada. En escritorio las tabs no se ven
           (CSS las oculta) y ambas columnas quedan visibles lado a lado
           como siempre. En móvil, JS alterna data-vista entre
           "ingredientes", "preparacion" y "todo". El contenido sigue
           completo en el DOM → SEO intacto. -->
      <div class="receta-tabs" role="tablist" aria-label="Secciones de la receta">
        <button type="button" role="tab" id="tab-ingredientes"
                aria-controls="seccion-ingredientes" aria-selected="true"
                data-tab="ingredientes">Ingredientes</button>
        <button type="button" role="tab" id="tab-preparacion"
                aria-controls="seccion-preparacion" aria-selected="false"
                data-tab="preparacion">Preparación</button>
        <button type="button" role="tab" id="tab-todo"
                aria-selected="false" data-tab="todo">Ver todo</button>
      </div>

      <div class="cuerpo" id="recetaCuerpo" data-vista="todo">
        <div class="cuerpo-col" data-seccion="ingredientes"
             id="seccion-ingredientes" role="tabpanel"
             aria-labelledby="tab-ingredientes">
          <h3>Ingredientes</h3>
          <ul class="ingredientes">
            {receta.ingredientes.map(ing => (
              <li style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:0.8rem;">
                <label style="flex:1;"><input type="checkbox"><span>{ing}</span></label>
                <button type="button" class="btn-add-ing" data-ing={ing} aria-label="Añadir a lista de compras">+</button>
              </li>
            ))}
          </ul>
          <button type="button" class="btn-add-all">Añadir todos los ingredientes</button>
        </div>
        <div class="cuerpo-col" data-seccion="preparacion"
             id="seccion-preparacion" role="tabpanel"
             aria-labelledby="tab-preparacion">
          <h3>Preparación</h3>
          <ol class="preparacion">
            {receta.pasos.map(paso => <li>{paso}</li>)}
          </ol>
          {receta.dato && <p class="dato"><strong>Dato:</strong> {receta.dato}</p>}
        </div>
      </div>
    </article>

    {receta.errores && receta.errores.length > 0 && (
      <details class="errores-box accordion-receta" open>
        <summary class="accordion-receta-summary">
          <h3>Errores comunes y cómo evitarlos</h3>
          <span class="accordion-receta-chevron" aria-hidden="true"></span>
        </summary>
        <div class="accordion-receta-contenido">
          <ul class="errores-lista">
            {receta.errores.map(err => (
              <li>
                <strong class="error">{err.error}</strong>
                <span class="solucion">{err.solucion}</span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    )}

    {receta.conservacion && (
      <details class="conservacion-box accordion-receta" open>
        <summary class="accordion-receta-summary">
          <h3>Conservación y Recalentado</h3>
          <span class="accordion-receta-chevron" aria-hidden="true"></span>
        </summary>
        <div class="accordion-receta-contenido">
          <div class="conservacion-grid">
            {receta.conservacion.refrigerador && <div class="conservacion-item"><strong>Refrigerador</strong>{receta.conservacion.refrigerador}</div>}
            {receta.conservacion.congelador && <div class="conservacion-item"><strong>Congelador</strong>{receta.conservacion.congelador}</div>}
            {receta.conservacion.recalentar && <div class="conservacion-item full-width"><strong>Recalentar</strong>{receta.conservacion.recalentar}</div>}
          </div>
          <div style="margin-top:1rem; font-size:0.85rem; text-align:right;">
            <a href="/guia-conservacion/" style="color:#0369a1; text-decoration:underline; font-weight:600;">Ver guía completa de conservación →</a>
          </div>
        </div>
      </details>
    )}

    {receta.tags && receta.tags.length > 0 && (
      <div class="receta-tags">
        {receta.tags.map(t => <span class="tag">#{t}</span>)}
      </div>
    )}

    {guiaAsociada && (
      <div class="receta-guia-box">
        <div class="guia-icon" set:html={ICON_LIBRO}></div>
        <div class="guia-texto">
          <span class="guia-eyebrow">Guía recomendada</span>
          <a href={guiaAsociada.url}>{guiaAsociada.titulo} →</a>
        </div>
      </div>
    )}

    <div class="compartir-receta">
      <span>¿Te gustó esta receta?</span>
      <a href={linkWA} target="_blank" rel="noopener" class="btn-whatsapp">
