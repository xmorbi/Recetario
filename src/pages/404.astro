---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada" description="La página que buscas no existe o cambió de lugar." noindex={true}>
  <header class="hero-receta">
    <div class="hero-receta-inner">
      <h1>Página no encontrada</h1>
    </div>
  </header>
  <main class="legal-page legal-page--lectura">
    <p>Esa dirección no existe o la receta cambió de lugar. Prueba con el buscador del menú.</p>
    <p><a href="/recetario/">Ver todas las recetas</a> · <a href="/">Volver al inicio</a></p>
  </main>
</Layout>