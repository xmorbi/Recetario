---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gracias por escribir" description="Tu mensaje fue recibido." noindex={true}>
  <main class="pagina-404">
    <div class="icono">📬</div>
    <h1>¡Gracias por escribir!</h1>
    <p>Tu mensaje llegó correctamente. Te responderé en 2-4 días hábiles al correo que dejaste.</p>
    <a href="/" class="btn-volver">
      Volver al recetario
    </a>
  </main>
</Layout>
