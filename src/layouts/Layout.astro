---
// PERF: el CSS global vive en src/styles/global.css y se importa aquí, para que
// Astro lo procese, lo versione (hash) y lo inlinee según build.inlineStylesheets.
// Antes era /estilos.css en public/ (archivo externo render-blocking).
import '../styles/global.css';

// FASE 8: fuentes autoalojadas (sin peticiones a Google Fonts).
// Se importan los pesos que usa global.css. @fontsource ya incluye font-display: swap.
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/fraunces/900.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

const {
  title = 'Recetario Chileno',
  description = 'Las mejores recetas tradicionales chilenas explicadas paso a paso.',
  canonicalURL,
  activePage = '',
  noindex = false,
  image = '/img/og-default.jpg',
  imageWidth,
  imageHeight,
  imageAlt,
  ogType = 'website',
} = Astro.props;

const siteUrl = Astro.site;
if (!siteUrl) {
  throw new Error(
    '[Layout] Astro.site no está configurado. Verifica PUBLIC_SITE_URL en astro.config.mjs.'
  );
}

const siteTitle = title === 'Recetario Chileno' ? title : `${title} | Recetario Chileno`;
const canonicalResolved = canonicalURL ?? new URL(Astro.url.pathname, siteUrl);
const canonical = canonicalResolved.toString();
const ogImage = /^https?:\/\//.test(image) ? image : new URL(image, siteUrl).toString();

const herramientasActivo = ['conservacion', 'calculadora', 'conversor', 'planificador'].includes(
  activePage
);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- FASE 2 (auditoría): aplicar el tema ANTES del paint (anti-FOUC) -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- FASE 8: PWA (manifest, theme-color, apple-touch-icon) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#b03a2e" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Recetario Chileno" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="es_CL" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    <!-- FASE 3 (auditoría): GTM/GA4 se cargan SOLO después de consentimiento. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.__gtm_loaded = false;
      window.cargarGTM = function () {
        if (window.__gtm_loaded) return;
        window.__gtm_loaded = true;
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-KXH425KQ');
      };
    </script>

    <!-- Centralización de dominio: exponer el origin a los scripts del cliente -->
    <script is:inline define:vars={{ SITE_ORIGIN: Astro.site?.origin || '' }}>
      window.__SITE_URL = SITE_ORIGIN;
    </script>

    <slot name="head" />
    <slot name="jsonld" />
  </head>
  <body>
    <div class="bandera" aria-hidden="true">
      <i class="azul"></i>
      <i class="blanco"></i>
      <i class="rojo"></i>
    </div>

    <header class="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="site-nav-logo" aria-label="Recetario Chileno — Inicio">
          <div class="marca-logo" aria-hidden="true">
            <span class="estrella"></span>
          </div>
          <span class="marca-texto">Recetario Chileno</span>
        </a>
        <!-- FASE 2: se eliminó el botón hamburguesa. En móvil la navegación la asume .tabbar. -->
        <nav class="site-nav-links" aria-label="Navegación principal">
          <form class="nav-search" action="/recetario/" method="get" role="search">
            <svg
              class="nav-search-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input
              type="search"
              id="nav-buscador"
              name="buscar"
              placeholder="Buscar receta…"
              aria-label="Buscar recetas"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="nav-buscador-sugerencias"
            />
            <ul
              id="nav-buscador-sugerencias"
              class="ac-dropdown ac-dropdown-nav"
              role="listbox"
              aria-label="Sugerencias de búsqueda"
              hidden
            ></ul>
          </form>

          <a href="/" class={activePage === 'inicio' ? 'activo' : ''}>
            Inicio
          </a>
          <a href="/recetario/" class={activePage === 'recetas' ? 'activo' : ''}>
            Recetas
          </a>
          <a href="/guias/" class={activePage === 'guias' ? 'activo' : ''}>
            Guías
          </a>
          <a href="/guia-conservacion/" class={activePage === 'conservacion' ? 'activo' : ''}>
            Conservación
          </a>

          <a href="/recetario/?cat=modo-once" class="nav-once-link">
            🧉 Once
          </a>

          <details class="dropdown-tools">
            <summary>Herramientas ▾</summary>
            <div class="dropdown-menu">
              <a href="/calculadora/" class={activePage === 'calculadora' ? 'activo' : ''}>
                Calculadora
              </a>
              <a href="/conversor/" class={activePage === 'conversor' ? 'activo' : ''}>
                Conversor
              </a>
              <a href="/planificador/" class={activePage === 'planificador' ? 'activo' : ''}>
                Planificador
              </a>
            </div>
          </details>

          <a href="/mis-recetas/" class={activePage === 'mis-recetas' ? 'activo' : ''}>
            Mis recetas
          </a>

          <button
            id="theme-toggle"
            type="button"
            style="background:none; border:none; cursor:pointer; padding:0.5rem; color:var(--tinta); font-size:1.2rem; display:flex; align-items:center; margin-left: 0.5rem;"
            aria-label="Cambiar tema"
            aria-pressed="false"
          >
            🌙
          </button>
        </nav>
      </div>
    </header>

    <main id="contenido-principal">
      <slot />
    </main>

    <footer>
      <div class="bandera" aria-hidden="true">
        <i class="azul"></i>
        <i class="blanco"></i>
        <i class="rojo"></i>
      </div>
      <span class="footer-flag" role="img" aria-label="Bandera de Chile"></span>
      Recetario Chileno · Hecho con cariño en Chile
      <nav class="footer-legal" aria-label="Enlaces legales">
        <a href="/sobre-mi/">Sobre nosotros</a>
        <span class="sep">·</span>
        <a href="/privacidad/">Privacidad</a>
        <span class="sep">·</span>
        <a href="/contacto/">Contacto</a>
        <span class="sep">·</span>
        <button type="button" id="link-preferencias-cookies" class="footer-link-btn">
          Preferencias de cookies
        </button>
      </nav>
    </footer>

    <!-- ============================================================
       FASE 2 — TABBAR INFERIOR (solo móvil, ≤768px)
       Visible solo bajo 768px. En desktop display:none.
       ============================================================ -->
    <nav class="tabbar" aria-label="Navegación principal móvil">
      <a
        href="/"
        class={`tabbar-item${activePage === 'inicio' ? ' activo' : ''}`}
        aria-current={activePage === 'inicio' ? 'page' : undefined}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        <span class="tabbar-label">Inicio</span>
      </a>

      <a
        href="/recetario/"
        class={`tabbar-item${activePage === 'recetas' ? ' activo' : ''}`}
        aria-current={activePage === 'recetas' ? 'page' : undefined}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
          <path d="M7 2v20" />
          <path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
        </svg>
        <span class="tabbar-label">Recetas</span>
      </a>

      <a
        href="/guias/"
        class={`tabbar-item${activePage === 'guias' ? ' activo' : ''}`}
        aria-current={activePage === 'guias' ? 'page' : undefined}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
        </svg>
        <span class="tabbar-label">Guías</span>
      </a>

      <a
        href="/mis-recetas/"
        class={`tabbar-item${activePage === 'mis-recetas' ? ' activo' : ''}`}
        aria-current={activePage === 'mis-recetas' ? 'page' : undefined}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        <span class="tabbar-label">Mis recetas</span>
      </a>

      <details class={`tabbar-tools${herramientasActivo ? ' activo' : ''}`}>
        <summary>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
          <span class="tabbar-label">Herramientas</span>
        </summary>
        <div class="tabbar-tools-menu">
          <a href="/calculadora/">Calculadora</a>
          <a href="/conversor/">Conversor</a>
          <a href="/planificador/">Planificador</a>
          <hr />
          <a href="/guia-conservacion/">Conservación</a>
          <a href="/recetario/?cat=modo-once">Once</a>
        </div>
      </details>
    </nav>

    <div id="cookie-banner" class="cookie-banner" hidden>
      <div class="cookie-content">
        <p>
          🍪 Utilizamos cookies propias y de terceros para analizar el tráfico y mejorar tu
          experiencia. Puedes aceptar o rechazar su uso. Más info en nuestra{' '}
          <a href="/privacidad/">Política de Privacidad</a>.
        </p>
        <div class="cookie-botones">
          <button id="btn-rechazar-cookies" class="btn-cookie btn-cookie-secundario" type="button">
            Rechazar
          </button>
          <button id="btn-aceptar-cookies" class="btn-cookie" type="button">
            Aceptar
          </button>
        </div>
      </div>
    </div>

    <!-- Scripts Vite (Bundled) -->
    <script>
      import '../scripts/nav.js';
      import '../scripts/lista-compras.js';
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        function getSafeItem(key) {
          try {
            return localStorage.getItem(key);
          } catch (e) {
            return null;
          }
        }
        function setSafeItem(key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (e) {}
        }

        if (getSafeItem('cookies_aceptadas') === 'true' && typeof window.cargarGTM === 'function') {
          window.cargarGTM();
        }

        // --- MODO OSCURO ---
        var toggle = document.getElementById('theme-toggle');
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (toggle) {
          toggle.textContent = isDark ? '☀️' : '🌙';
          toggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          toggle.addEventListener('click', function () {
            var theme = document.documentElement.getAttribute('data-theme');
            if (theme === 'dark') {
              document.documentElement.removeAttribute('data-theme');
              setSafeItem('theme', 'light');
              toggle.textContent = '🌙';
              toggle.setAttribute('aria-pressed', 'false');
            } else {
              document.documentElement.setAttribute('data-theme', 'dark');
              setSafeItem('theme', 'dark');
              toggle.textContent = '☀️';
              toggle.setAttribute('aria-pressed', 'true');
            }
          });
        }

        // --- AVISO DE COOKIES + CARGA DE GTM AL ACEPTAR ---
        var cookieBanner = document.getElementById('cookie-banner');
        var btnAceptarCookies = document.getElementById('btn-aceptar-cookies');
        var btnRechazarCookies = document.getElementById('btn-rechazar-cookies');
        var linkPreferenciasCookies = document.getElementById('link-preferencias-cookies');

        function mostrarBannerCookies() {
          if (!cookieBanner) return;
          cookieBanner.hidden = false;
          void cookieBanner.offsetHeight;
          setTimeout(function () {
            cookieBanner.classList.add('visible');
          }, 50);
        }

        function ocultarBannerCookies() {
          if (!cookieBanner) return;
          cookieBanner.classList.remove('visible');
          setTimeout(function () {
            cookieBanner.hidden = true;
          }, 300);
        }

        function registrarConsentimiento(valor) {
          setSafeItem('cookies_aceptadas', valor);
          if (valor === 'true' && typeof window.cargarGTM === 'function') {
            window.cargarGTM();
          }
          ocultarBannerCookies();
        }

        window.abrirPreferenciasCookies = function () {
          try {
            localStorage.removeItem('cookies_aceptadas');
          } catch (e) {}
          mostrarBannerCookies();
        };

        if (cookieBanner && !getSafeItem('cookies_aceptadas')) {
          setTimeout(mostrarBannerCookies, 1000);
        }

        if (btnAceptarCookies) {
          btnAceptarCookies.addEventListener('click', function () {
            registrarConsentimiento('true');
          });
        }
        if (btnRechazarCookies) {
          btnRechazarCookies.addEventListener('click', function () {
            registrarConsentimiento('false');
          });
        }
        if (linkPreferenciasCookies) {
          linkPreferenciasCookies.addEventListener('click', function (e) {
            e.preventDefault();
            window.abrirPreferenciasCookies();
          });
        }
      });
    </script>

    <!-- FASE 8: registro del service worker (no bloquea el load) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function (err) {
            console.warn('Service Worker no registrado:', err);
          });
        });
      }
    </script>
  </body>
</html>