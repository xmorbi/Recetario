---
// PERF: el CSS global vive en src/styles/global.css y se importa aquí, para que
// Astro lo procese, lo versione (hash) y lo inlinee según build.inlineStylesheets.
// Antes era /estilos.css en public/ (archivo externo render-blocking).
import '../styles/global.css';

const {
  title = 'Recetario Chileno',
  description = 'Las mejores recetas tradicionales chilenas explicadas paso a paso.',
  // Centralización: canonical explícito con Astro.site, sin query params.
  // ⚠️ CAMBIO: se elimina el fallback a netlify.app (astro.config.mjs ya garantiza Astro.site).
  canonicalURL,
  activePage = '',
  noindex = false,
  // FASE 2 (Mejora 2): metadatos Open Graph / Twitter centralizados.
  // Acepta rutas relativas ('/img/foo.jpg') o URLs absolutas ('https://...').
  image = '/img/og-default.jpg',
  imageWidth,
  imageHeight,
  imageAlt,
  ogType = 'website'
} = Astro.props;

// ⚠️ CAMBIO: fail-fast. El astro.config ya aborta si falta PUBLIC_SITE_URL,
// pero por defensa aquí también validamos para no generar URLs relativas rotas.
const siteUrl = Astro.site;
if (!siteUrl) {
  throw new Error(
    '[Layout] Astro.site no está configurado. Verifica PUBLIC_SITE_URL en astro.config.mjs.'
  );
}

const siteTitle = title === 'Recetario Chileno' ? title : `${title} | Recetario Chileno`;
const canonicalResolved = canonicalURL ?? new URL(Astro.url.pathname, siteUrl);
const canonical = canonicalResolved.toString();
const ogImage = /^https?:\/\//.test(image)
  ? image
  : new URL(image, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="es-CL">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- FASE 2 (auditoría): aplicar el tema ANTES del paint (anti-FOUC) -->
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- ⚠️ CAMBIO (perf): preconnect a Google Fonts para reducir latencia de la petición bloqueante. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <title>{siteTitle}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, follow">}
  <link rel="canonical" href={canonical}>

  <!-- Open Graph (FASE 2: centralizado aquí, sin duplicados en [slug].astro) -->
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="Recetario Chileno">
  <meta property="og:title" content={siteTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  {imageWidth && <meta property="og:image:width" content={String(imageWidth)}>}
  {imageHeight && <meta property="og:image:height" content={String(imageHeight)}>}
  {imageAlt && <meta property="og:image:alt" content={imageAlt}>}
  <meta property="og:locale" content="es_CL">

  <!-- Twitter Cards (FASE 2) -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={siteTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  {imageAlt && <meta name="twitter:image:alt" content={imageAlt}>}

  <!--
    FASE 3 (auditoría): GTM/GA4 se cargan SOLO después de consentimiento.
    Sin GTM pre-consent. Sin <noscript> de GTM (el usuario sin JS no puede
    dar consentimiento, así que no cargamos tracking).
  -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    window.__gtm_loaded = false;
    window.cargarGTM = function () {
      if (window.__gtm_loaded) return;
      window.__gtm_loaded = true;
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-KXH425KQ');
      // GA4 vía GTM (si prefieres GA4 directo, descomenta las dos líneas siguientes
      // y quita el tag GA4 de GTM):
      // gtag('js', new Date());
      // gtag('config', 'G-PCNBDPPXXYP');
    };
  </script>

  <!-- Centralización de dominio: exponer el origin a los scripts del cliente -->
  <script is:inline define:vars={{ SITE_ORIGIN: Astro.site?.origin || '' }}>
    window.__SITE_URL = SITE_ORIGIN;
  </script>

  <!-- PERF: el CSS global ahora se importa en el frontmatter (src/styles/global.css);
       Astro inyecta su <style>/<link> automáticamente. Ya no se enlaza /estilos.css. -->
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <slot name="head" />
  <!-- FASE 2 (2.3): slot dedicado para JSON-LD estructurado, separado del head genérico.
       Mantenemos "head" para no romper otras páginas que ya lo usan. -->
  <slot name="jsonld" />
</head>
<body>
  <!-- ⚠️ CAMBIO (a11y): bandera decorativa → aria-hidden para no ensuciar el árbol accesible. -->
  <div class="bandera" aria-hidden="true"><i class="azul"></i><i class="blanco"></i><i class="rojo"></i></div>

  <header class="site-nav">
    <div class="site-nav-inner">
      <a href="/" class="site-nav-logo" aria-label="Recetario Chileno — Inicio">
        <!-- ⚠️ CAMBIO (a11y): logo decorativo → aria-hidden. -->
        <div class="marca-logo" aria-hidden="true"><span class="estrella"></span></div>
        <span class="marca-texto">Recetario Chileno</span>
      </a>
      <button class="site-nav-toggle" type="button" aria-label="Abrir menú" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <nav class="site-nav-links" aria-label="Navegación principal">

        <form class="nav-search" action="/recetario/" method="get" role="search">
          <svg class="nav-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <!-- ⚠️ CAMBIO (a11y): se mantiene role="combobox" pero se añade role="listbox"
               al <ul> de sugerencias para que la relación aria-controls sea válida.
               Antes el <ul> era un listbox huérfano (causa del aviso "ARIA prohibited"). -->
          <input type="search" id="nav-buscador" name="buscar" placeholder="Buscar receta…" aria-label="Buscar recetas" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="nav-buscador-sugerencias">
          <ul id="nav-buscador-sugerencias" class="ac-dropdown ac-dropdown-nav" role="listbox" aria-label="Sugerencias de búsqueda" hidden></ul>
        </form>

        <a href="/" class={activePage === 'inicio' ? 'activo' : ''}>Inicio</a>
        <a href="/recetario/" class={activePage === 'recetas' ? 'activo' : ''}>Recetas</a>
        <a href="/guias/" class={activePage === 'guias' ? 'activo' : ''}>Guías</a>
        <a href="/guia-conservacion/" class={activePage === 'conservacion' ? 'activo' : ''}>Conservación</a>

        <a href="/recetario/?cat=modo-once" class="nav-once-link">🧉 Once</a>

        <details class="dropdown-tools">
          <summary>Herramientas ▾</summary>
          <div class="dropdown-menu">
            <a href="/calculadora/" class={activePage === 'calculadora' ? 'activo' : ''}>Calculadora</a>
            <a href="/conversor/" class={activePage === 'conversor' ? 'activo' : ''}>Conversor</a>
            <a href="/planificador/" class={activePage === 'planificador' ? 'activo' : ''}>Planificador</a>
          </div>
        </details>

        <a href="/mis-recetas/" class={activePage === 'mis-recetas' ? 'activo' : ''}>Mis recetas</a>

        <!-- ⚠️ CAMBIO (a11y/HTML): type="button" para evitar submit accidental si algún día
             este botón queda dentro de un <form>. No cambia comportamiento actual. -->
        <button id="theme-toggle" type="button" style="background:none; border:none; cursor:pointer; padding:0.5rem; color:var(--tinta); font-size:1.2rem; display:flex; align-items:center; margin-left: 0.5rem;" aria-label="Cambiar tema">
          🌙
        </button>
      </nav>
    </div>
  </header>

  <!-- ⚠️ CAMBIO (a11y CRÍTICO): landmark principal <main> que PageSpeed reportaba como ausente.
       Envuelve el slot para que cada página tenga un único <main> implícito. -->
  <main id="contenido-principal">
    <slot />
  </main>

  <footer>
    <div class="bandera" aria-hidden="true"><i class="azul"></i><i class="blanco"></i><i class="rojo"></i></div>
    <!-- ⚠️ CAMBIO (a11y): <span aria-label="..."> sin role es "ARIA prohibida" (genérico).
         Se le asigna role="img" para preservar el significado y cumplir WAI-ARIA 1.2. -->
    <span class="footer-flag" role="img" aria-label="Bandera de Chile"></span>
    Recetario Chileno · Hecho con cariño en Chile
    <nav class="footer-legal" aria-label="Enlaces legales">
      <a href="/sobre-mi/">Sobre nosotros</a><span class="sep">·</span>
      <a href="/privacidad/">Privacidad</a><span class="sep">·</span>
      <a href="/contacto/">Contacto</a><span class="sep">·</span>
      <!-- FASE 2 (2.2): reabre el banner para cambiar la decisión de cookies -->
      <button type="button" id="link-preferencias-cookies" class="footer-link-btn">Preferencias de cookies</button>
    </nav>
  </footer>

  <div id="cookie-banner" class="cookie-banner" hidden>
    <div class="cookie-content">
      <p>🍪 Utilizamos cookies propias y de terceros para analizar el tráfico y mejorar tu experiencia. Puedes aceptar o rechazar su uso. Más info en nuestra <a href="/privacidad/">Política de Privacidad</a>.</p>
      <!-- FASE 2 (2.1): botones Aceptar / Rechazar con persistencia en localStorage -->
      <div class="cookie-botones">
        <button id="btn-rechazar-cookies" class="btn-cookie btn-cookie-secundario" type="button">Rechazar</button>
        <button id="btn-aceptar-cookies" class="btn-cookie" type="button">Aceptar</button>
      </div>
    </div>
  </div>

  <script is:inline src="/nav.js" defer></script>
  <script is:inline src="/lista-compras.js"></script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      function getSafeItem(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
      function setSafeItem(key, value) { try { localStorage.setItem(key, value); } catch (e) {} }

      // FASE 3 (auditoría): si ya aceptó, cargar GTM al instante.
      if (getSafeItem('cookies_aceptadas') === 'true' && typeof window.cargarGTM === 'function') {
        window.cargarGTM();
      }

      // --- MODO OSCURO ---
      var toggle = document.getElementById('theme-toggle');
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (toggle) toggle.textContent = isDark ? '☀️' : '🌙';
      if (toggle) {
        toggle.addEventListener('click', function() {
          var theme = document.documentElement.getAttribute('data-theme');
          if (theme === 'dark') {
            document.documentElement.removeAttribute('data-theme');
            setSafeItem('theme', 'light');
            toggle.textContent = '🌙';
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            setSafeItem('theme', 'dark');
            toggle.textContent = '☀️';
          }
        });
      }

      // --- AVISO DE COOKIES + CARGA DE GTM AL ACEPTAR ---
      // FASE 2 (2.1 / 2.2): consentimiento aceptar/rechazar + reapertura desde footer.
      var cookieBanner = document.getElementById('cookie-banner');
      var btnAceptarCookies = document.getElementById('btn-aceptar-cookies');
      var btnRechazarCookies = document.getElementById('btn-rechazar-cookies');
      var linkPreferenciasCookies = document.getElementById('link-preferencias-cookies');

      function mostrarBannerCookies() {
        if (!cookieBanner) return;
        cookieBanner.hidden = false;
        // forzar reflow para que la transición CSS se dispare al reabrir
        void cookieBanner.offsetHeight;
        setTimeout(function() { cookieBanner.classList.add('visible'); }, 50);
      }

      function ocultarBannerCookies() {
        if (!cookieBanner) return;
        cookieBanner.classList.remove('visible');
        setTimeout(function() { cookieBanner.hidden = true; }, 300);
      }

      // valor: 'true' = aceptar | 'false' = rechazar
      function registrarConsentimiento(valor) {
        setSafeItem('cookies_aceptadas', valor);
        if (valor === 'true' && typeof window.cargarGTM === 'function') {
          window.cargarGTM();
        }
        ocultarBannerCookies();
      }

      // Expuesto para que el enlace del footer pueda reabrir el banner.
      window.abrirPreferenciasCookies = function () {
        try { localStorage.removeItem('cookies_aceptadas'); } catch (e) {}
        mostrarBannerCookies();
      };

      // Mostrar el banner solo si no hay una decisión previa.
      // ('false' es truthy, así que un rechazo previo NO reabre el banner.)
      if (cookieBanner && !getSafeItem('cookies_aceptadas')) {
        setTimeout(mostrarBannerCookies, 1000);
      }

      if (btnAceptarCookies) {
        btnAceptarCookies.addEventListener('click', function() { registrarConsentimiento('true'); });
      }
      if (btnRechazarCookies) {
        btnRechazarCookies.addEventListener('click', function() { registrarConsentimiento('false'); });
      }
      if (linkPreferenciasCookies) {
        linkPreferenciasCookies.addEventListener('click', function(e) {
          e.preventDefault();
          window.abrirPreferenciasCookies();
        });
      }
    });
  </script>
</body>
</html>