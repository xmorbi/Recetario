---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Planificador Semanal Inteligente" description="Crea un menú semanal adaptado a tus restricciones alimentarias." activePage="planificador">

  <header class="hero-receta">
    <div class="hero-receta-inner">
      <h1>Planificador Inteligente</h1>
      <p class="hero-sub">Genera un menú semanal seguro, adaptado a tus restricciones de salud.</p>
    </div>
  </header>

  <main class="legal-page" style="max-width: 1100px;">
    <div style="background: #fff3cd; border-left: 6px solid #ffc107; padding: 1.5rem; border-radius: 0 var(--radio) var(--radio) 0; margin-bottom: 2.5rem; color: #664d03; box-shadow: var(--sombra-sm);">
      <strong style="display: flex; align-items: center; gap: 0.5rem; font-size: 1.2rem; margin-bottom: 0.5rem;">⚠️ Aviso importante para tu salud</strong>
      <p style="margin: 0; font-size: 0.95rem; line-height: 1.6;">Esta herramienta filtra recetas según las restricciones que selecciones, pero <strong>no reemplaza el consejo de tu médico o nutricionista</strong>. Siempre revisa las etiquetas de los productos que compres. Ante cualquier duda sobre un ingrediente, descarta la receta y consulta a un profesional.</p>
    </div>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: var(--fuente-titulos); color: var(--rojo-osc); font-size: 1.8rem; margin-bottom: 1rem;">1. Configura tu perfil alimentario</h2>
      <p style="color: var(--suave); margin-bottom: 1.5rem;">Marca las opciones que <strong>debes evitar</strong> o los objetivos que buscas.</p>

      <div class="restricciones-grid">
        <label class="restriccion-item"><input type="checkbox" value="lacteos" class="check-restriccion"><span>🚫 Sin Lácteos</span></label>
        <label class="restriccion-item"><input type="checkbox" value="gluten" class="check-restriccion"><span>🌾 Sin Gluten</span></label>
        <label class="restriccion-item"><input type="checkbox" value="frutos_secos" class="check-restriccion"><span>🥜 Sin Frutos Secos</span></label>
        <label class="restriccion-item"><input type="checkbox" value="mariscos" class="check-restriccion"><span>🦐 Sin Mariscos/Pescado</span></label>
        <label class="restriccion-item"><input type="checkbox" value="huevo" class="check-restriccion"><span>🥚 Sin Huevo</span></label>
        <label class="restriccion-item"><input type="checkbox" value="carne" class="check-restriccion"><span>🥩 Vegetariano (Sin carnes)</span></label>
        <label class="restriccion-item"><input type="checkbox" value="vegano" class="check-restriccion"><span>🌱 Vegano (100% vegetal)</span></label>
        <label class="restriccion-item"><input type="checkbox" value="keto" class="check-restriccion"><span>🥑 Keto (Muy bajo en carbos)</span></label>
        <label class="restriccion-item"><input type="checkbox" value="sin_azucar" class="check-restriccion"><span>🍬 Sin Azúcar Añadida</span></label>
        <label class="restriccion-item"><input type="checkbox" value="alto_proteina" class="check-restriccion"><span>💪 Alto en Proteína</span></label>
      </div>
    </section>

    <section style="text-align: center; margin-bottom: 3rem; background: var(--crema-osc); padding: 2.5rem; border-radius: var(--radio); border: 2px dashed var(--borde);">
      <h2 style="font-family: var(--fuente-titulos); color: var(--rojo-osc); font-size: 1.6rem; margin-bottom: 1rem;">2. Genera tu semana</h2>
      <p style="color: var(--suave); margin-bottom: 1.5rem;">Haremos una propuesta automática. Los días que fijes con el candado (🔒) no cambiarán.</p>
      <button type="button" id="btn-generar-semana" class="btn-calc btn-calc-primary" style="max-width: 380px; margin: 0 auto; display: flex; font-size: 1.1rem; padding: 1rem 2rem; box-shadow: 0 6px 20px rgba(176,58,46,.3);">
        ✨ Generar semana compatible con mis filtros
      </button>
    </section>

    <section id="panel-semana" hidden>
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h2 style="font-family: var(--fuente-titulos); color: var(--rojo-osc); font-size: 1.8rem; margin: 0;">3. Tu menú sugerido</h2>
          <p style="color: var(--suave); margin: 0.5rem 0 0 0; font-size: 0.95rem;">Usa el candado para fijar los platos que te gustaron.</p>
        </div>
        <button type="button" id="btn-limpiar-semana" class="btn-volver-empezar">Borrar semana</button>
      </div>

      <div id="mensaje-faltan-recetas" style="display: none; color: #664d03; background: #fff3cd; padding: 1rem; border-radius: 8px; margin-top: 1rem; font-weight: 600; border-left: 4px solid #ffc107;"></div>

      <div class="minutas-grid" id="contenedor-minutas"></div>

      <div style="text-align: center; margin-top: 3rem;">
        <button type="button" id="btn-agregar-lista" class="btn-calc btn-calc-primary" style="max-width: 350px; margin: 0 auto; display: flex; font-size: 1.1rem;">
          🛒 Enviar ingredientes a mi lista
        </button>
      </div>
    </section>
  </main>

  <dialog id="modal-cambiar-receta" class="modal-dinamico">
    <div class="modal-dinamico-header">
      <h3 id="modal-titulo-dia">Cambiar receta</h3>
      <button type="button" id="btn-cerrar-modal" aria-label="Cerrar">✕</button>
    </div>
    <div class="modal-dinamico-body">
      <input type="search" id="buscador-modal" placeholder="Buscar receta segura..." aria-label="Buscar receta" style="margin-bottom: 1rem;">
      <ul id="lista-modal-recetas" class="lista-modal-recetas"></ul>
    </div>
  </dialog>

  <script is:inline>
    document.addEventListener('recetas-listas', function() {
      function safeGet(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
      function safeSet(key, value) { try { localStorage.setItem(key, value); } catch (e) {} }
      function safeRemove(key) { try { localStorage.removeItem(key); } catch (e) {} }

      // FASE 3 (auditoría): diccionario con \b (límites de palabra) para
      // evitar falsos positivos ("panqueque" ya no se bloquea por "pan").
      const ANIMALES_VEGANO = 'carne(?! de (soya|soja|trigo|vegetal|girasol))|carnes(?! de (soya|soja|trigo|vegetal|girasol))|pollo|pollos|cerdo|cerdos|vacuno|vacunos|pavo|pavos|cordero|corderos|bistec|bistecs|churrasco|churrascos|salchicha|salchichas|vienesa|vienesas|chorizo|chorizos|jam[oó]n|jamones|tocino|tocinos|prieta|prietas|longaniza|longanizas|costillar|costillares|pulpa|pulpas|posta|postas|charqui|charquis|hueso|huesos|menudencia|menudencias|guatita|guatitas|chunchule|chunchules|pernil|perniles|malaya|malayas|pescado|pescados|camar[oó]n|camarones|chorito|choritos|almeja|almejas|macha|machas|loco|locos|jaiba|jaibas|centolla|centollas|congrio|congrios|corvina|corvinas|merluza|merluzas|reineta|reinetas|salm[oó]n|at[uú]n|jurel|jureles|pulpo|pulpos|calamar|calamares|picoroco|picorocos|cholga|cholgas|osti[oó]n|ostiones|marisco|mariscos|leche(?! de (coco|almendra|soya|avena|arroz))|queso|quesos|mantequilla|crema(?! de (coco|almendra|verduras))|yogur|yogurt|parmesano|manjar|manteca|suero|case[ií]na|huevo|huevos|clara|claras|yema|yemas|miel|caldo de carne|caldo de pollo|caldo de hueso';

      const DICCIONARIO = {
        lacteos: /\b(leche(?! de (coco|almendra|soya|avena|arroz))|queso|mantequilla|crema(?! de (coco|almendra|verduras))|yogur|yogurt|parmesano|manjar|manteca|suero|case[ií]na)\b/i,
        gluten: /\b(harina(?! de (almendra|coco|arroz))|pan|marraqueta|hallulla|fideo|fideos|tallar[ií]n|tallarines|pasta|galleta|galletas|masa|s[eé]mola|polvos de hornear|levadura|cerveza)\b/i,
        frutos_secos: /\b(nuez|nueces|almendra|almendras|man[ií]|avellana|avellanas|pistacho|pistachos|casta[nñ]a|casta[nñ]as|pi[nñ][oó]n|pi[nñ]ones)\b/i,
        mariscos: /\b(pescado|pescados|camar[oó]n|camarones|chorito|choritos|almeja|almejas|macha|machas|loco|locos|jaiba|jaibas|centolla|centollas|congrio|congrios|corvina|corvinas|merluza|merluzas|reineta|reinetas|salm[oó]n|at[uú]n|jurel|jureles|pulpo|pulpos|calamar|calamares|picoroco|picorocos|cholga|cholgas|osti[oó]n|ostiones|marisco|mariscos)\b/i,
        huevo: /\b(huevo|huevos|clara|claras|yema|yemas)\b/i,
        carne: /\b(carne(?! de (soya|soja|trigo|vegetal|girasol))|carnes(?! de (soya|soja|trigo|vegetal|girasol))|pollo|pollos|cerdo|cerdos|vacuno|vacunos|pavo|pavos|cordero|corderos|bistec|bistecs|churrasco|churrascos|salchicha|salchichas|vienesa|vienesas|chorizo|chorizos|jam[oó]n|jamones|tocino|tocinos|prieta|prietas|longaniza|longanizas|costillar|costillares|pulpa|pulpas|posta|postas|charqui|charquis|hueso|huesos|menudencia|menudencias|guatita|guatitas|chunchule|chunchules|pernil|perniles|malaya|malayas)\b/i,
        vegano: new RegExp('\\b(' + ANIMALES_VEGANO + ')\\b', 'i'),
        keto: /\b(harina|harinas|pan|panes|marraqueta|marraquetas|hallulla|hallullas|fideo|fideos|tallar[ií]n|tallarines|pasta|pastas|galleta|galletas|masa|masas|s[eé]mola|arroz|arroces|papa|papas|patata|patatas|camote|camotes|choclo|choclos|arveja|arvejas|poroto|porotos|lenteja|lentejas|garbanzo|garbanzos|az[uú]car|chancaca|miel|manjar|fruta|frutas|pl[aá]tano|pl[aá]tanos|manzana|manzanas|pera|peras|durazno|duraznos|naranja|naranjas|jugo|jugos|cerveza|cervezas|vino|vinos)\b/i,
        sin_azucar: /\b(az[uú]car|chancaca|miel|manjar|caramelo|camelos|jarabe|jarabes|syrup|mermelada|mermeladas|dulce|dulces)\b/i
      };

      // FASE 3 (auditoría): tags positivos que anulan la restricción.
      // Si la receta ya está adaptada (ej. "pan nube" con tag "sin-gluten"),
      // no se bloquea aunque el título contenga "pan".
      const TAGS_POSITIVAS = {
        lacteos: /\bsin[- ]?l[aá]cteos?\b|\bsin[- ]?leche\b|\bvegan[oa]?\b/i,
        gluten: /\bsin[- ]?gluten\b|\bsin[- ]?tacc\b|\bcel[ií]ac[oa]?\b|\bapto[- ]?cel[ií]ac/i,
        frutos_secos: /\bsin[- ]?frutos?[- ]?secos?\b|\bsin[- ]?nueces?\b|\bsin[- ]?mani\b/i,
        mariscos: /\bsin[- ]?mariscos?\b|\bsin[- ]?pescado\b|\bvegetarian[oa]?\b|\bvegan[oa]?\b/i,
        huevo: /\bsin[- ]?huevos?\b|\bvegan[oa]?\b/i,
        carne: /\bvegetarian[oa]?\b|\bvegan[oa]?\b|\bsin[- ]?carne\b/i,
        vegano: /\bvegan[oa]?\b|\b100%[- ]?vegetal\b/i,
        keto: /\bketo\b|\blow[- ]?carb\b|\bcetog[eé]nic[oa]\b/i,
        sin_azucar: /\bsin[- ]?az[uú]car\b|\bsugar[- ]?free\b|\bdiab[eé]tic[oa]\b/i,
        alto_proteina: /\balto[- ]?en[- ]?prote[ií]na\b|\bhigh[- ]?protein\b/i
      };

      const PROTEINAS = /\b(carne|carnes|pollo|pollos|cerdo|cerdos|vacuno|vacunos|pavo|pavos|cordero|corderos|bistec|bistecs|churrasco|churrascos|pescado|pescados|camar[oó]n|camarones|chorito|choritos|almeja|almejas|huevo|huevos|queso|quesos|manjar|lenteja|lentejas|poroto|porotos|garbanzo|garbanzos|at[uú]n|salm[oó]n|jurel|jureles|leche(?! de (coco|almendra|soya|avena|arroz)))\b/i;

      const CATEGORIAS_VALIDAS = ['principales', 'sopas', 'ensaladas', 'mar', 'de-olla'];
      const TAGS_EXCLUIDOS = ['salsa', 'picoteo', 'acompañamiento', 'postre', 'merienda'];
      const ICONOS_CAT = { 'principales': '🥩', 'sopas': '🥣', 'ensaladas': '🥗', 'mar': '🐟', 'de-olla': '🍲' };

      const diasSemana = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];

      const hoy = new Date().getDay();
      const mapaDias = { 0: 6, 1: 0, 2: 1, 3: 2, 4: 3, 5: 4, 6: 5 };
      const indexHoy = mapaDias[hoy];

      let minutasActuales = JSON.parse(safeGet('planificador_semana')) || {};
      let restriccionesGuardadas = JSON.parse(safeGet('planificador_restricciones')) || [];
      let recetasFijadas = JSON.parse(safeGet('planificador_fijadas')) || {};
      let recetasPermitidasGlobal = [];

      const btnGenerar = document.getElementById('btn-generar-semana');
      const panelSemana = document.getElementById('panel-semana');
      const contenedorMinutas = document.getElementById('contenedor-minutas');
      const btnLimpiar = document.getElementById('btn-limpiar-semana');
      const btnAgregarLista = document.getElementById('btn-agregar-lista');
      const mensajeFaltan = document.getElementById('mensaje-faltan-recetas');
      const modal = document.getElementById('modal-cambiar-receta');
      const btnCerrarModal = document.getElementById('btn-cerrar-modal');
      const buscadorModal = document.getElementById('buscador-modal');
      const listaModalRecetas = document.getElementById('lista-modal-recetas');
      let diaActualModal = '';

      document.querySelectorAll('.check-restriccion').forEach(cb => {
        if (restriccionesGuardadas.includes(cb.value)) cb.checked = true;
        cb.addEventListener('change', function() {
          restriccionesGuardadas = Array.from(document.querySelectorAll('.check-restriccion:checked')).map(c => c.value);
          safeSet('planificador_restricciones', JSON.stringify(restriccionesGuardadas));
        });
      });

      function tieneTagPositiva(receta, restriccion) {
        const tagsTexto = (receta.tags || []).join(' ');
        const regex = TAGS_POSITIVAS[restriccion];
        return regex ? regex.test(tagsTexto) : false;
      }

      function obtenerRecetasSeguras(restricciones) {
        return RECETAS.filter(receta => {
          if (!CATEGORIAS_VALIDAS.includes(receta.categoria)) return false;
          if (receta.tags && receta.tags.some(t => TAGS_EXCLUIDOS.includes(t.toLowerCase()))) return false;

          const ingredientesValidos = (receta.ingredientes || []).filter(ing => !/\(opcional\)/i.test(ing) && !/opcional:/i.test(ing));
          const textoReceta = ((receta.titulo || '') + ' ' + ingredientesValidos.join(' ') + ' ' + (receta.tags || []).join(' ')).toLowerCase();

          for (let i = 0; i < restricciones.length; i++) {
            const filtro = restricciones[i];
            if (filtro === 'alto_proteina') continue;
            // Si la receta ya está marcada como apta, saltar esta restricción
            if (tieneTagPositiva(receta, filtro)) continue;
            const regex = DICCIONARIO[filtro];
            if (regex && regex.test(textoReceta)) return false;
          }
          if (restricciones.includes('alto_proteina') && !PROTEINAS.test(textoReceta)) return false;
          return true;
        });
      }

      if (Object.keys(minutasActuales).length > 0) {
        recetasPermitidasGlobal = obtenerRecetasSeguras(restriccionesGuardadas);
        renderizarSemana();
      }

      btnGenerar.addEventListener('click', function() {
        if (typeof RECETAS === 'undefined') return alert('Error: No se pudieron cargar las recetas.');

        recetasPermitidasGlobal = obtenerRecetasSeguras(restriccionesGuardadas);
        if (recetasPermitidasGlobal.length === 0) return alert('Tus restricciones son tan estrictas que no encontramos NINGUNA receta principal segura.');

        recetasPermitidasGlobal.sort(() => 0.5 - Math.random());

        let indexReceta = 0;
        diasSemana.forEach(dia => {
          if (recetasFijadas[dia] && minutasActuales[dia]) return;
          minutasActuales[dia] = recetasPermitidasGlobal[indexReceta % recetasPermitidasGlobal.length].titulo;
          indexReceta++;
        });

        guardarSemana();

        if (recetasPermitidasGlobal.length < 7) {
          mensajeFaltan.style.display = 'block';
          mensajeFaltan.innerHTML = `⚠️ <strong>Tus restricciones son muy estrictas.</strong> Solo hay ${recetasPermitidasGlobal.length} recetas seguras. Algunos días se repetirán.`;
        } else {
          mensajeFaltan.style.display = 'none';
        }
        renderizarSemana();
      });

      function guardarSemana() {
        safeSet('planificador_semana', JSON.stringify(minutasActuales));
        safeSet('planificador_fijadas', JSON.stringify(recetasFijadas));
      }

      function renderizarSemana() {
        contenedorMinutas.innerHTML = '';

        diasSemana.forEach((dia, index) => {
          const recetaTitulo = minutasActuales[dia];
          const recetaObj = RECETAS ? RECETAS.find(r => r.titulo === recetaTitulo) : null;

          const slug = recetaObj ? (recetaObj.slug || slugify(recetaObj.titulo)) : '';

          const cat = recetaObj ? recetaObj.categoria : 'principales';
          const icono = ICONOS_CAT[cat] || '🍽️';

          const esPasado = index < indexHoy;
          const estaFijada = !!recetasFijadas[dia];

          const card = document.createElement('div');
          card.className = `minuta-card ${esPasado ? 'dia-pasado' : ''} ${estaFijada ? 'fijada' : ''}`;

          if (!recetaTitulo) {
            card.innerHTML = `
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.8rem;"><h3 class="minuta-dia" style="margin:0;">${dia} ${esPasado ? '(Pasado)' : ''}</h3></div>
              <div class="minuta-receta-nombre" style="color: var(--suave); font-style: italic; font-size: 1rem;">Día libre (Sin receta)</div>
              <div class="minuta-acciones">
                <button type="button" class="btn-minuta btn-cambiar" data-dia="${dia}">🔄 Elegir</button>
                <button type="button" class="btn-minuta btn-azar" data-dia="${dia}">🎲 Azar</button>
              </div>
            `;
          } else {
            // FASE 3 (auditoría): URL limpia /recetas/{slug}/
            card.innerHTML = `
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.8rem;">
                <h3 class="minuta-dia" style="margin:0;">${dia} ${esPasado ? '(Pasado)' : ''}</h3>
                <div style="display:flex; align-items:center; gap: 0.4rem;">
                  <button type="button" class="btn-fijar ${estaFijada ? 'fijado' : ''}" data-dia="${dia}" title="${estaFijada ? 'Desfijar receta' : 'Fijar para no cambiarla'}">${estaFijada ? '🔒' : '🔓'}</button>
                  <span title="Categoría: ${cat}">${icono}</span>
                  <button type="button" class="btn-eliminar-dia" data-dia="${dia}" title="Dejar día libre" aria-label="Eliminar receta">✕</button>
                </div>
              </div>
              <div class="minuta-receta-nombre">${recetaTitulo}</div>
              <div class="minuta-acciones">
                <button type="button" class="btn-minuta btn-cambiar" data-dia="${dia}">🔄 Elegir a dedo</button>
                <button type="button" class="btn-minuta btn-azar" data-dia="${dia}">🎲 Al azar</button>
              </div>
              ${slug ? `<div style="margin-top: 1rem; text-align: center;"><a href="/recetas/${slug}/" style="color: var(--rojo); font-size: 0.85rem; text-decoration: underline;">Ver receta completa →</a></div>` : ''}
            `;
          }
          contenedorMinutas.appendChild(card);
        });

        document.querySelectorAll('.btn-cambiar').forEach(btn => btn.addEventListener('click', function() { abrirModal(this.getAttribute('data-dia')); }));
        document.querySelectorAll('.btn-azar').forEach(btn => btn.addEventListener('click', function() {
            const dia = this.getAttribute('data-dia');
            if (recetasPermitidasGlobal.length === 0) return;
            minutasActuales[dia] = recetasPermitidasGlobal[Math.floor(Math.random() * recetasPermitidasGlobal.length)].titulo;
            guardarSemana(); renderizarSemana();
        }));
        document.querySelectorAll('.btn-eliminar-dia').forEach(btn => btn.addEventListener('click', function() {
            const dia = this.getAttribute('data-dia');
            minutasActuales[dia] = '';
            recetasFijadas[dia] = false;
            guardarSemana(); renderizarSemana();
        }));

        document.querySelectorAll('.btn-fijar').forEach(btn => btn.addEventListener('click', function() {
            const dia = this.getAttribute('data-dia');
            recetasFijadas[dia] = !recetasFijadas[dia];
            guardarSemana(); renderizarSemana();
        }));

        panelSemana.hidden = false;
      }

      function abrirModal(dia) {
        diaActualModal = dia;
        document.getElementById('modal-titulo-dia').textContent = `Elegir receta para el ${dia}`;
        buscadorModal.value = '';
        const restriccionesActuales = Array.from(document.querySelectorAll('.check-restriccion:checked')).map(c => c.value);
        recetasPermitidasGlobal = obtenerRecetasSeguras(restriccionesActuales);
        renderizarListaModal('');
        modal.showModal();
      }

      function renderizarListaModal(filtro) {
        const filtroNorm = filtro.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const filtradas = recetasPermitidasGlobal.filter(r => r.titulo.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').includes(filtroNorm));
        if (filtradas.length === 0) { listaModalRecetas.innerHTML = '<li style="padding: 1rem; text-align: center; color: var(--suave);">No se encontraron recetas seguras.</li>'; return; }

        listaModalRecetas.innerHTML = filtradas.map(r => `
          <li data-titulo="${r.titulo}"><span>${ICONOS_CAT[r.categoria] || '🍽️'} ${r.titulo}</span><span style="color: var(--rojo); font-size: 0.8rem; font-weight: bold;">Elegir</span></li>
        `).join('');

        listaModalRecetas.querySelectorAll('li').forEach(li => li.addEventListener('click', function() {
            minutasActuales[diaActualModal] = this.getAttribute('data-titulo');
            guardarSemana(); modal.close(); renderizarSemana();
        }));
      }

      buscadorModal.addEventListener('input', function() { renderizarListaModal(this.value); });
      btnCerrarModal.addEventListener('click', function() { modal.close(); });

      btnLimpiar.addEventListener('click', function() {
        if(confirm('¿Seguro que quieres borrar tu semana y quitar todos los candados?')) {
            panelSemana.hidden = true;
            minutasActuales = {};
            recetasFijadas = {};
            safeRemove('planificador_semana');
            safeRemove('planificador_fijadas');
        }
      });

      btnAgregarLista.addEventListener('click', function() {
        if (typeof window.agregarItemLista !== 'function') return alert('El sistema de lista de compras no está disponible.');
        let itemsAgregados = 0;
        for (const dia in minutasActuales) {
          if (!minutasActuales[dia]) continue;
          const recetaOriginal = RECETAS.find(r => r.titulo === minutasActuales[dia]);
          if (recetaOriginal && recetaOriginal.ingredientes) {
            recetaOriginal.ingredientes.forEach(ing => {
              window.agregarItemLista({ id: ing, nombre: ing, cantidad: 0, unidad: '' });
              itemsAgregados++;
            });
          }
        }
        if (itemsAgregados > 0) {
          alert('¡Ingredientes añadidos a tu lista de compras! Abriendo lista...');
          if (window.ListaCompras && window.ListaCompras.abrir) window.ListaCompras.abrir();
        }
      });

      function slugify(text) { return String(text).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''); }
    });
  </script>

  <script is:inline>
    window.RECETAS = [];
    fetch('/api/recetas.json')
      .then(res => res.json())
      .then(data => {
        window.RECETAS = data;
        document.dispatchEvent(new Event('recetas-listas'));
      })
      .catch(err => console.error('Error cargando recetas:', err));
  </script>
</Layout>