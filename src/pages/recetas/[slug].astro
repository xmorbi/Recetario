  <script>
    import '../../scripts/modo-cocina.js';
    import '../../scripts/escalador.js';
    import '../../scripts/favoritos.js';
    import '../../scripts/estrellas.js';
    import '../../scripts/print-marcados.js';
    import '../../scripts/receta-tabs.js';
  </script>

  <!-- BLOQUE 1: botón manual "Guardar para cocinar sin conexión". -->
  <script is:inline>
    (function () {
      if (!('serviceWorker' in navigator)) {
        document.querySelectorAll('.btn-offline').forEach(function (btn) {
          btn.addEventListener('click', function () {
            btn.textContent = 'Tu navegador no soporta modo offline';
            btn.disabled = true;
          });
        });
        return;
      }

      var pending = null;

      navigator.serviceWorker.addEventListener('message', function (event) {
        var data = event.data;
        if (!data || data.type !== 'CACHE_RECIPE_DONE') return;
        if (!pending || pending.url !== data.url) return;
        var btn = pending.btn;
        pending = null;
        if (!btn) return;
        if (data.fail === 0 && data.ok > 0) {
          btn.textContent = '✅ Guardada para sin conexión';
        } else if (data.ok > 0) {
          btn.textContent = '⚠️ Guardada parcialmente (' + data.ok + '/' + (data.ok + data.fail) + ')';
          btn.disabled = false;
        } else {
          btn.textContent = 'No se pudo guardar; reintenta';
          btn.disabled = false;
        }
      });

      document.querySelectorAll('.btn-offline').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var textoOriginal = btn.textContent;
          btn.textContent = 'Guardando…';
          btn.disabled = true;

          navigator.serviceWorker.ready.then(function (reg) {
            if (!reg.active) {
              btn.textContent = 'No se pudo guardar; reintenta';
              btn.disabled = false;
              return;
            }

            var url = btn.dataset.url;
            var imgRel = btn.dataset.image || '';
            var imageUrl = imgRel ? new URL(imgRel, window.location.origin).href : null;

            var resources = performance.getEntriesByType('resource')
              .map(function (e) { return e.name; })
              .filter(function (n) {
                try {
                  var u = new URL(n);
                  return u.origin === window.location.origin && n !== url;
                } catch (e) {
                  return false;
                }
              });

            pending = { url: url, btn: btn };

            reg.active.postMessage({
              type: 'CACHE_RECIPE',
              url: url,
              imageUrl: imageUrl,
              resources: resources
            });

            setTimeout(function () {
              if (pending && pending.url === url) {
                pending = null;
                btn.textContent = 'No se pudo confirmar; reintenta';
                btn.disabled = false;
              }
            }, 20000);
          }).catch(function () {
            btn.textContent = 'No se pudo guardar; reintenta';
            btn.disabled = false;
          });
        });
      });
    })();
  </script>

  <!-- FASE 8 — 8.7: Accordion de "Errores" y "Conservación".
       En móvil (≤720px) los bloques se muestran colapsados por defecto
       para reducir el scroll vertical del artículo. En desktop quedan
       abiertos (el CSS anula el chevron y el cursor pointer).
       Sin JS: abierto en todos los viewports (mismo comportamiento que antes). -->
  <script is:inline>
    (function () {
      if (!window.matchMedia('(max-width: 720px)').matches) return;
      var abiertos = document.querySelectorAll('.accordion-receta[open]');
      for (var i = 0; i < abiertos.length; i++) {
        abiertos[i].removeAttribute('open');
      }
    })();
  </script>

  <!-- FASE C — Ocultar FAB del carrito cuando el escalador o "Añadir todos"
       entran en la zona del FAB (últimos ~20% del viewport).
       - El FAB vive en el body (creado por lista-compras.js en su DOMContentLoaded).
       - Este observer espera a que exista con reintentos cortos.
       - Degradación: si IntersectionObserver no existe, FAB visible siempre.
       - No modifica lista-compras.js ni el comportamiento del carrito. -->
  <script is:inline>
    (function () {
      'use strict';

      if (!('IntersectionObserver' in window)) return;

      var intentos = 0;
      var MAX_INTENTOS = 30; // ~1.8s máximo (60ms × 30)

      function arrancar() {
        var fab = document.getElementById('shopping-fab');

        // El FAB lo crea lista-compras.js en su propio DOMContentLoaded.
        // Este script puede registrar su listener antes o después;
        // con reintentos cubrimos ambos órdenes.
        if (!fab) {
          intentos++;
          if (intentos > MAX_INTENTOS) return;
          setTimeout(arrancar, 60);
          return;
        }

        var targets = [];
        var escalador = document.querySelector('.escalador');
        var btnAll = document.querySelector('.btn-add-all');
        if (escalador) targets.push(escalador);
        if (btnAll) targets.push(btnAll);
        if (targets.length === 0) return;

        // Observa solo los últimos 20% del viewport (zona donde vive el FAB).
        // rootMargin -80% arriba ⇒ la "ventana" del observer es la franja
        // inferior del viewport. Cuando el escalador cruza esa franja,
        // isIntersecting = true y ocultamos el FAB.
        var observer = new IntersectionObserver(function (entries) {
          var algunoVisible = false;
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) { algunoVisible = true; break; }
          }
          if (algunoVisible) {
            fab.classList.add('shopping-fab--oculto');
          } else {
            fab.classList.remove('shopping-fab--oculto');
          }
        }, {
          rootMargin: '-80% 0px 0px 0px',
          threshold: 0
        });

        for (var j = 0; j < targets.length; j++) {
          observer.observe(targets[j]);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', arrancar);
      } else {
        arrancar();
      }
    })();
  </script>

</Layout>