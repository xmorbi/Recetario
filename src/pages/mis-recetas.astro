---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mis Recetas Favoritas"
  description="Tus recetas guardadas en este dispositivo."
  activePage="mis-recetas"
  noindex={true}
>
  <header class="hero-receta">
    <div class="hero-receta-inner">
      <h1>Mis recetas favoritas</h1>
      <p class="sub" style="color:var(--suave); font-style:italic; margin-top:1rem;">
        Tus recetas guardadas en este dispositivo.
      </p>
    </div>
  </header>

  <div>
    <div id="contenedorFavoritos" class="recetas-grid-favoritos" style="min-height: 50vh;"></div>
  </div>

  <script>
    import '../scripts/app.js';
    import '../scripts/favoritos.js';
  </script>

  <script is:inline>
    window.RECETAS = [];
    fetch('/api/recetas.json?v=2')
      .then((res) => res.json())
      .then((data) => {
        window.RECETAS = data;
        document.dispatchEvent(new Event('recetas-listas'));
      })
      .catch((err) => console.error('Error cargando recetas:', err));
  </script>
</Layout>