{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recetario",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
}
